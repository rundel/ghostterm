{
  "name": "ghostterm",
  "version": "0.0.2",
  "private": true,
  "libghostty-vt": "1.0.1",
  "description": "Browser terminal on libghostty-vt's WebAssembly module, with an xterm.js-compatible API",
  "type": "module",
  "module": "./dist/ghostterm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ghostterm.js"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ghostterm-slim.js"
    },
    "./ghostty-vt.wasm": "./dist/ghostty-vt.wasm",
    "./ghostty-vt-fast.wasm": "./dist/ghostty-vt-fast.wasm"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rundel/ghostterm.git"
  },
  "license": "MIT",
  "author": "Colin Rundel",
  "scripts": {
    "build": "rm -rf dist && ./scripts/fetch-wasm.sh && vite build && vite build --mode slim && cp ghostty-vt.wasm ghostty-vt-fast.wasm dist/ && bun scripts/check-dist.ts",
    "demo": "node demo/bin/demo.js",
    "bench": "bun bench/versus.ts",
    "release": "bun scripts/release.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write --cache .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^15.11.0",
    "@lydell/node-pty": "^1.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@xterm/xterm": "^5.5.0",
    "mitata": "^1.0.34",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "ws": "^8.18.0"
  }
}
