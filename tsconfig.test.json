{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "allowJs": true
  },
  "include": [
    "lib/**/*.test.ts",
    "lib/test-helpers.ts",
    "happydom.ts",
    "test-cleanup.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "demo/bin/*.test.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "scripts/dist-consumer.ts"]
}
